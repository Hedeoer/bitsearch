{
  "name": "bitsearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "APP_HOST=127.0.0.1 APP_PORT=8098 tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "mcp:inspect": "tsx scripts/mcp-inspector-open.ts",
    "mcp:inspect:smoke": "tsx scripts/mcp-inspector-smoke.ts",
    "mcp:conformance": "tsx scripts/mcp-conformance.ts",
    "mcp:modern-smoke": "tsx scripts/modern-mcp-smoke.ts",
    "mcpjam:doctor": "tsx scripts/mcpjam-doctor.ts",
    "mcpjam:eval": "tsx scripts/mcpjam-eval.ts",
    "mcp:tooling": "npm run mcp:inspect:smoke && npm run mcp:conformance && npm run mcpjam:doctor",
    "smoke:mcp-large-results": "tsx scripts/mcp-large-result-smoke.ts",
    "seed:admin-demo": "tsx scripts/seed-admin-demo.ts",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.77",
    "@ai-sdk/google": "^2.0.70",
    "@ai-sdk/openai": "^2.0.57",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "ai": "^5.0.84",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.7.0",
    "nanoid": "^5.1.5",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mcpjam/cli": "3.28.0",
    "@mcpjam/sdk": "6.3.0",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@modelcontextprotocol/inspector": "2.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.3"
  }
}
